ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://intakeflow:intakeflow@localhost:5432/intakeflow
REDIS_URL=redis://localhost:6379/0
APP_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
SESSION_HOURS=24
DEMO_ACCOUNTS_ENABLED=true

# Explicit offline simulation. For live extraction set AI_PROVIDER=openai and both values below.
AI_PROVIDER=demo
OPENAI_API_KEY=
# Select a model with native structured outputs available to your account; see docs/ai.md.
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=2200
AI_MAX_INPUT_CHARS=24000
AI_MAX_CALLS=4
JOB_LEASE_SECONDS=300
# Optional USD per million tokens, for the chosen model. Unset means unknown cost.
# INPUT_PRICE_PER_MILLION=
# OUTPUT_PRICE_PER_MILLION=
